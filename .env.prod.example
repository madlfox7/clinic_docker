# Production example; secrets stay in secrets/.
POSTGRES_USER=clinic
POSTGRES_DB=clinic
# SMTP password: secrets/smtp_password.
SMTP_HOST=smtp.example.org
SMTP_PORT=587
SMTP_FROM=noreply@clinic.example.org
SMTP_STARTTLS=true
SMTP_SSL=false
SMTP_USERNAME=clinic
# Public HTTPS origin; no port/path.
PUBLIC_BASE_URL=https://clinic.example.org
# Your certificate; init checks it, tls_reload.sh renews it.
CLINIC_TLS_MODE=provided
# Optional host-only CA.
# CLINIC_TLS_CA_FILE=/etc/clinic/corporate-ca.pem
# HTTP-01 webroot (optional).
CLINIC_ACME_WEBROOT=false
# One-year HSTS; no subdomains/preload.
CLINIC_HSTS_MAX_AGE=31536000
CLINIC_PROXY_PORT=80
CLINIC_PROXY_TLS_PORT=443
SESSION_ABSOLUTE_HOURS=12
SESSION_SAME_SITE=lax
SESSION_HTTPS_ONLY=true
HOST_UID=1000
HOST_GID=1000
