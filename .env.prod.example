# Production example: copy to .env on the server and adjust. Non-secret
# settings only; passwords and keys live in secrets/ (scripts/init_secrets.sh).
POSTGRES_USER=clinic
POSTGRES_DB=clinic
# Your SMTP server (password in secrets/smtp_password).
SMTP_HOST=smtp.example.org
SMTP_PORT=587
SMTP_FROM=noreply@clinic.example.org
SMTP_STARTTLS=true
SMTP_SSL=false
SMTP_USERNAME=clinic
# Public HTTPS origin, no port (443) and no path.
PUBLIC_BASE_URL=https://clinic.example.org
# provided: secrets/tls/server.crt (full chain) and server.key are yours;
# scripts/init_secrets.sh only checks them. Renew with scripts/tls_reload.sh.
CLINIC_TLS_MODE=provided
# Optional: a corporate CA not in the system store (stays on the host, never mounted).
# CLINIC_TLS_CA_FILE=/etc/clinic/corporate-ca.pem
# HTTP-01 webroot (with docker-compose.acme.yml); DNS-01 needs neither.
CLINIC_ACME_WEBROOT=false
# One year; no includeSubDomains, no preload.
CLINIC_HSTS_MAX_AGE=31536000
CLINIC_PROXY_PORT=80
CLINIC_PROXY_TLS_PORT=443
SESSION_ABSOLUTE_HOURS=12
SESSION_SAME_SITE=lax
SESSION_HTTPS_ONLY=true
HOST_UID=1000
HOST_GID=1000
