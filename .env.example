# Non-secret settings only. Passwords and keys live in secrets/ (see scripts/init_secrets.sh).
POSTGRES_USER=clinic
POSTGRES_DB=clinic
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=noreply@clinic.local
SMTP_STARTTLS=false
SMTP_SSL=false
SMTP_USERNAME=
PUBLIC_BASE_URL=http://localhost:8080
HOST_UID=1000
HOST_GID=1000
# Session cookie: absolute limit in hours (3-24), SameSite (lax|strict), Secure flag (true only behind TLS).
# The idle timeout is set by the admin in /admin/settings (5-120 minutes, default 30).
SESSION_ABSOLUTE_HOURS=12
SESSION_SAME_SITE=lax
SESSION_HTTPS_ONLY=false
