# Only non-secrets here; passwords and keys stay in secrets/.
POSTGRES_USER=clinic
POSTGRES_DB=clinic
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=noreply@clinic.local
SMTP_STARTTLS=false
SMTP_SSL=false
SMTP_USERNAME=
# Public HTTPS origin; HTTP redirects here.
PUBLIC_BASE_URL=https://localhost:8450
# HSTS max-age in seconds.
CLINIC_HSTS_MAX_AGE=3600
# local: generated CA; provided: your cert.
CLINIC_TLS_MODE=local
# Set to 1 for a public tunnel.
# CLINIC_PUBLIC_TUNNEL=0
# Reserved ngrok domain; token stays in ngrok config.
NGROK_DOMAIN=outspoken-wiry-fabric.ngrok-free.dev
HOST_UID=1000
HOST_GID=1000
# Session cookie settings.
# Admin sets idle timeout.
SESSION_ABSOLUTE_HOURS=12
SESSION_SAME_SITE=lax
SESSION_HTTPS_ONLY=true
# CLINIC_PROXY_BIND=127.0.0.1  # local only; default: all interfaces
# CLINIC_PROXY_PORT=8080
