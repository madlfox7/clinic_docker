# Non-secret settings only. Passwords and keys live in secrets/ (see scripts/init_secrets.sh).
POSTGRES_USER=clinic
POSTGRES_DB=clinic
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=noreply@clinic.local
SMTP_STARTTLS=false
SMTP_SSL=false
SMTP_USERNAME=
# HTTPS origin of the site (no path). The proxy sends plain HTTP here with 308.
PUBLIC_BASE_URL=https://localhost:8450
# HSTS max-age in seconds (31536000 in production); no includeSubDomains or preload.
CLINIC_HSTS_MAX_AGE=3600
# local: stand CA made by scripts/init_secrets.sh; provided: your own certificate.
CLINIC_TLS_MODE=local
# 1: PUBLIC_BASE_URL is a public tunnel domain (ngrok demo, https, no port) in
# front of this stand; local mode only. Mail links and the HTTP redirect go there.
# CLINIC_PUBLIC_TUNNEL=0
HOST_UID=1000
HOST_GID=1000
# Session cookie: absolute limit in hours (3-24), SameSite (lax|strict), Secure flag, true behind TLS (default).
# The idle timeout is set by the admin in /admin/settings (5-120 minutes, default 30).
SESSION_ABSOLUTE_HOURS=12
SESSION_SAME_SITE=lax
SESSION_HTTPS_ONLY=true
# CLINIC_PROXY_BIND=127.0.0.1  # this machine only; default 0.0.0.0 (all interfaces)
# CLINIC_PROXY_PORT=8080
